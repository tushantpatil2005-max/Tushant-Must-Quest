<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>TeamPulse — 1:1 Prep Copilot (Prototype)</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');

  :root{
    --navy:#12263A;
    --navy-2:#1B3A57;
    --teal:#1E7F72;
    --amber:#C98A3B;
    --paper:#F6F4EF;
    --panel:#FFFFFF;
    --line:#E1DDD3;
    --ink:#1A1A1A;
    --muted:#6B6B63;
    --fail:#B4433A;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; background:var(--paper); color:var(--ink);
    font-family:'Inter',sans-serif; -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:1100px;margin:0 auto;padding:32px 24px 80px;}
  header{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:2px solid var(--navy);padding-bottom:16px;margin-bottom:28px;}
  .brand{font-family:'Fraunces',serif;font-weight:700;font-size:28px;color:var(--navy);letter-spacing:-0.01em;}
  .brand span{color:var(--teal);}
  .tag{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted);background:#fff;border:1px solid var(--line);padding:4px 10px;border-radius:3px;}
  .grid{display:grid;grid-template-columns:280px 1fr 300px;gap:24px;align-items:start;}
  @media (max-width:900px){.grid{grid-template-columns:1fr;}}

  .panel{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:18px;}
  .panel h3{font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);margin:0 0 12px;}

  .report-btn{display:block;width:100%;text-align:left;background:#fff;border:1px solid var(--line);border-radius:5px;padding:12px;margin-bottom:8px;cursor:pointer;font-family:'Inter';transition:border-color .15s;}
  .report-btn:hover{border-color:var(--navy);}
  .report-btn.active{border-color:var(--teal);background:#EEF6F4;}
  .report-btn .name{font-weight:600;font-size:14px;}
  .report-btn .role{font-size:12px;color:var(--muted);}

  .generate-btn{width:100%;margin-top:8px;background:var(--navy);color:#fff;border:none;border-radius:5px;padding:12px;font-weight:600;font-size:14px;cursor:pointer;font-family:'Inter';}
  .generate-btn:hover{background:var(--navy-2);}
  .generate-btn:disabled{opacity:0.5;cursor:default;}

  .brief-card{background:var(--panel);border:1px solid var(--line);border-radius:6px;overflow:hidden;}
  .brief-head{background:var(--navy);color:#fff;padding:16px 20px;}
  .brief-head .who{font-family:'Fraunces',serif;font-weight:600;font-size:19px;}
  .brief-head .meta{font-size:12px;opacity:0.75;margin-top:2px;}
  .card-row{border-top:1px solid var(--line);padding:16px 20px;position:relative;}
  .card-row .lbl{display:flex;justify-content:space-between;align-items:center;font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:var(--teal);margin-bottom:8px;}
  .src{cursor:help;color:var(--muted);border-bottom:1px dotted var(--muted);font-family:'Inter';text-transform:none;letter-spacing:0;font-size:11px;}
  .src:hover + .tooltip{display:block;}
  .tooltip{display:none;position:absolute;right:20px;top:38px;background:var(--ink);color:#fff;font-family:'IBM Plex Mono',monospace;font-size:11px;padding:8px 10px;border-radius:4px;max-width:260px;z-index:5;}
  .card-row p{margin:0;font-size:15px;line-height:1.5;}
  .goal{display:flex;justify-content:space-between;font-size:14px;padding:4px 0;}
  .flag{font-family:'IBM Plex Mono',monospace;font-size:10px;padding:2px 8px;border-radius:10px;text-transform:uppercase;}
  .flag.ontrack{background:#E6F2E9;color:#2A7A3B;}
  .flag.atrisk{background:#FBEAE3;color:var(--fail);}
  .badge-ai{font-family:'IBM Plex Mono',monospace;font-size:10px;background:#FBF1E3;color:var(--amber);border:1px solid #E8CE9E;padding:2px 8px;border-radius:10px;}
  .footer-actions{display:flex;gap:8px;padding:14px 20px;background:#FAF9F5;border-top:1px solid var(--line);flex-wrap:wrap;}
  .footer-actions button{font-family:'Inter';font-size:13px;font-weight:500;padding:8px 12px;border-radius:5px;border:1px solid var(--line);background:#fff;cursor:pointer;}
  .footer-actions button:hover{border-color:var(--navy);}
  .footer-actions button.dismiss{color:var(--fail);}

  .empty{padding:60px 20px;text-align:center;color:var(--muted);font-size:14px;}
  .empty .icon{font-size:32px;margin-bottom:10px;}

  .log{font-family:'IBM Plex Mono',monospace;font-size:11.5px;line-height:1.7;color:var(--navy);}
  .log .line{border-bottom:1px dashed var(--line);padding:6px 0;}
  .log .k{color:var(--muted);}
  .status-ok{color:#2A7A3B;font-weight:600;}
  .status-fail{color:var(--fail);font-weight:600;}
  .status-idle{color:var(--muted);}

  .err-box{background:#FBEAE3;border:1px solid #E8B7AC;color:var(--fail);border-radius:5px;padding:12px 14px;font-size:13px;margin-top:12px;}
  .spinner{display:inline-block;width:14px;height:14px;border:2px solid var(--line);border-top-color:var(--navy);border-radius:50%;animation:spin .7s linear infinite;vertical-align:-2px;margin-right:6px;}
  @keyframes spin{to{transform:rotate(360deg);}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <div class="brand">Team<span>Pulse</span></div>
      <div style="font-size:12px;color:var(--muted);margin-top:2px;">1:1 Prep Copilot — Working Prototype</div>
    </div>
    <div class="tag">AI logic runs live · not a mockup</div>
  </header>

  <div class="grid">
    <!-- LEFT: report picker -->
    <div class="panel">
      <h3>Your Direct Reports</h3>
      <div id="reportList"></div>
    </div>

    <!-- CENTER: brief -->
    <div id="briefArea"></div>

    <!-- RIGHT: system log -->
    <div class="panel">
      <h3>System Log — Data Flow</h3>
      <div class="log" id="logArea">
        <div class="line"><span class="k">status</span><br><span class="status-idle">idle — select a report</span></div>
      </div>
    </div>
  </div>
</div>

<script>
const REPORTS = [
  {
    id: 'jordan', name: 'Jordan Reyes', role: 'Senior Analyst', lastMeeting: '9 days ago',
    pulseRaw: -0.3, pulseWindow: 'week of Aug 17', pulseN: 1,
    goals: [{name:'Q3 Migration Plan', status:'on track'}, {name:'Cross-team Handoff Doc', status:'at risk'}],
    lastNoteThread: 'wanted to revisit scope on the API project'
  },
  {
    id: 'priya', name: 'Priya Nair', role: 'Product Designer', lastMeeting: '15 days ago',
    pulseRaw: 0.6, pulseWindow: 'week of Aug 18', pulseN: 1,
    goals: [{name:'Onboarding Flow Redesign', status:'on track'}, {name:'Design System v2', status:'on track'}],
    lastNoteThread: 'flagged frustration with slow design-review turnaround'
  },
  {
    id: 'marcus', name: 'Marcus Webb', role: 'Support Team Lead', lastMeeting: '4 days ago',
    pulseRaw: -1.1, pulseWindow: 'week of Aug 19', pulseN: 1,
    goals: [{name:'Reduce Ticket Backlog', status:'at risk'}, {name:'New-Hire Ramp Plan', status:'at risk'}],
    lastNoteThread: 'mentioned being short-staffed on the support rotation'
  }
];

let selectedId = null;
let feedbackLog = [];

function renderReportList(){
  const el = document.getElementById('reportList');
  el.innerHTML = REPORTS.map(r => `
    <button class="report-btn ${r.id===selectedId?'active':''}" onclick="selectReport('${r.id}')">
      <div class="name">${r.name}</div>
      <div class="role">${r.role} · last 1:1 ${r.lastMeeting}</div>
    </button>
  `).join('') + `<button class="generate-btn" id="genBtn" onclick="generateBrief()" ${selectedId?'':'disabled'}>Generate Prep Brief</button>`;
}

function selectReport(id){
  selectedId = id;
  renderReportList();
  renderEmpty();
}

function renderEmpty(){
  document.getElementById('briefArea').innerHTML = `
    <div class="panel empty">
      <div class="icon">🗂️</div>
      Select a direct report, then click <strong>Generate Prep Brief</strong>.<br>
      This calls the model live — nothing below is pre-written.
    </div>`;
}

function log(lines){
  document.getElementById('logArea').innerHTML = lines.map(l =>
    `<div class="line"><span class="k">${l.k}</span><br>${l.v}</div>`
  ).join('');
}

function estCost(inTok, outTok){
  const inCost = (inTok/1000000)*2.50;
  const outCost = (outTok/1000000)*10.00;
  return (inCost+outCost);
}

// simple client-side guardrail: reject if the model strays into judgment / disciplinary language
const BANNED_PATTERNS = [
  /\bshould be (fired|terminated|let go)\b/i,
  /\bis (lazy|incompetent|a bad employee|unreliable as a person)\b/i,
  /\bperformance rating\b/i,
  /\bconsider (firing|demoting|putting .* on a pip)\b/i
];
function guardrailCheck(text){
  for(const p of BANNED_PATTERNS){ if(p.test(text)) return {pass:false, reason:'matched disallowed judgment pattern: '+p}; }
  return {pass:true};
}

async function generateBrief(){
  const report = REPORTS.find(r=>r.id===selectedId);
  const btn = document.getElementById('genBtn');
  btn.disabled = true;

  document.getElementById('briefArea').innerHTML = `<div class="panel empty"><span class="spinner"></span> Calling model…</div>`;

  const contextPayload = {
    report_name: report.name,
    role: report.role,
    last_meeting: report.lastMeeting,
    pulse_delta: report.pulseRaw,
    pulse_window: report.pulseWindow,
    pulse_sample_size: report.pulseN,
    goals: report.goals,
    last_open_thread: report.lastNoteThread
  };

  const systemPrompt = `You are the TeamPulse 1:1 Prep Copilot. You summarize structured HR data into a short prep brief for a people manager.
STRICT RULES:
- Only state facts present in the JSON context provided. Never invent data.
- NEVER infer performance ratings, discipline recommendations, or judgments about character, competence, or job security.
- Output ONLY valid JSON, no markdown fences, no commentary, matching exactly this schema:
{"pulse_summary": string (max 18 words, plain language, no raw numbers), "goals_note": string (max 14 words), "carried_over": string (max 16 words), "suggested_prompt": string (one open-ended question, max 20 words)}`;

  const inputTokEstimate = Math.round((systemPrompt.length + JSON.stringify(contextPayload).length) / 4);

  log([
    {k:'1. context payload assembled', v: '<pre style="white-space:pre-wrap;margin:0;">'+JSON.stringify(contextPayload,null,1)+'</pre>'},
    {k:'2. calling LLM', v: '<span class="spinner"></span> brief-generation call in flight…'}
  ]);

  let raw = '';
  let apiError = null;
  try{
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 300,
        system: systemPrompt,
        messages: [{role:"user", content: JSON.stringify(contextPayload)}]
      })
    });
    const data = await response.json();
    raw = (data.content || []).map(b => b.text || '').join('');
  }catch(e){
    apiError = e.message || String(e);
  }

  if(apiError || !raw){
    log([
      {k:'1. context payload assembled', v:'ok'},
      {k:'2. LLM call', v:`<span class="status-fail">FAILED</span> — ${apiError || 'empty response'}`},
      {k:'3. fallback behavior', v:'brief withheld; manager sees retry option rather than a broken/partial card'}
    ]);
    document.getElementById('briefArea').innerHTML = `
      <div class="panel">
        <div class="err-box">
          <strong>Brief generation failed.</strong> No partial or guessed content is shown — this is the fallback path, not a bug.
        </div>
        <button class="generate-btn" style="margin-top:12px;" onclick="generateBrief()">Retry</button>
      </div>`;
    btn.disabled = false;
    return;
  }

  let parsed;
  try{
    parsed = JSON.parse(raw.trim().replace(/^```json\s*|\s*```$/g,''));
  }catch(e){
    log([
      {k:'2. LLM call', v:'returned non-JSON output'},
      {k:'3. fallback behavior', v:'<span class="status-fail">parse error</span> — brief withheld, manager sees retry'}
    ]);
    document.getElementById('briefArea').innerHTML = `
      <div class="panel"><div class="err-box"><strong>Could not parse model output.</strong> Fallback: nothing unverified is shown.</div>
      <button class="generate-btn" style="margin-top:12px;" onclick="generateBrief()">Retry</button></div>`;
    btn.disabled = false;
    return;
  }

  const fullText = JSON.stringify(parsed);
  const outTokEstimate = Math.round(fullText.length/4);
  const gcheck = guardrailCheck(fullText);
  const cost = estCost(inputTokEstimate, outTokEstimate);

  log([
    {k:'1. context payload assembled', v:'ok — '+Object.keys(contextPayload).length+' fields'},
    {k:'2. LLM call', v:'<span class="status-ok">200 OK</span>'},
    {k:'3. guardrail validator', v: gcheck.pass ? '<span class="status-ok">PASS</span> — no disallowed judgment language detected' : '<span class="status-fail">FAIL</span> — '+gcheck.reason+' → brief withheld'},
    {k:'4. est. tokens (in / out)', v: inputTokEstimate + ' / ' + outTokEstimate},
    {k:'5. est. cost this call', v: '$'+cost.toFixed(4)+' (basis: $2.50/1M in, $10.00/1M out)'}
  ]);

  if(!gcheck.pass){
    document.getElementById('briefArea').innerHTML = `
      <div class="panel"><div class="err-box"><strong>Guardrail blocked this output.</strong> ${gcheck.reason}. The manager never sees it — this is the AI system boundary from the design spec enforced in code, not just in a document.</div>
      <button class="generate-btn" style="margin-top:12px;" onclick="generateBrief()">Regenerate</button></div>`;
    btn.disabled = false;
    return;
  }

  renderBrief(report, parsed);
  btn.disabled = false;
}

function renderBrief(report, brief){
  document.getElementById('briefArea').innerHTML = `
    <div class="brief-card">
      <div class="brief-head">
        <div class="who">1:1 Prep Brief</div>
        <div class="meta">${report.name} · ${report.role} · Last 1:1: ${report.lastMeeting}</div>
      </div>
      <div class="card-row">
        <div class="lbl">Pulse Signal <span class="src">source ⓘ</span></div>
        <div class="tooltip">Source: Pulse Survey, ${report.pulseWindow}<br>Raw delta: ${report.pulseRaw > 0 ? '+':''}${report.pulseRaw} pts (5-pt scale, n=${report.pulseN})</div>
        <p>${brief.pulse_summary}</p>
      </div>
      <div class="card-row">
        <div class="lbl">Goals <span class="src">source ⓘ</span></div>
        <div class="tooltip">Source: Goal-tracking module, live status as of today</div>
        ${report.goals.map(g => `<div class="goal"><span>${g.name}</span><span class="flag ${g.status==='on track'?'ontrack':'atrisk'}">${g.status}</span></div>`).join('')}
        <p style="margin-top:8px;color:var(--muted);font-size:13px;">${brief.goals_note}</p>
      </div>
      <div class="card-row">
        <div class="lbl">Carried-Over Thread <span class="src">source ⓘ</span></div>
        <div class="tooltip">Source: last 1:1 note, ${report.lastMeeting}</div>
        <p>${brief.carried_over}</p>
      </div>
      <div class="card-row">
        <div class="lbl">Suggested Prompt <span class="badge-ai">AI suggestion</span></div>
        <p>${brief.suggested_prompt}</p>
      </div>
      <div class="footer-actions">
        <button onclick="feedback('edit','${report.id}')">Edit brief</button>
        <button onclick="feedback('use','${report.id}')">Start notes from this</button>
        <button class="dismiss" onclick="feedback('dismiss','${report.id}')">Not helpful — dismiss</button>
      </div>
    </div>
    <div class="panel" style="margin-top:14px;">
      <h3>Feedback Log (backstage) — ${feedbackLog.length} events</h3>
      <div class="log">${feedbackLog.length ? feedbackLog.map(f=>`<div class="line">${f}</div>`).join('') : '<span class="status-idle">no actions logged yet</span>'}</div>
    </div>
  `;
}

function feedback(action, id){
  const stamp = new Date().toLocaleTimeString();
  feedbackLog.unshift(`[${stamp}] ${action} — ${id} (feeds prompt-tuning store)`);
  const report = REPORTS.find(r=>r.id===id);
  // re-render just the feedback panel without re-calling the API
  const panels = document.querySelectorAll('#briefArea .panel');
  if(panels.length) panels[panels.length-1].querySelector('.log').innerHTML =
    feedbackLog.map(f=>`<div class="line">${f}</div>`).join('');
  const h3 = document.querySelector('#briefArea .panel h3');
  if(h3) h3.textContent = `Feedback Log (backstage) — ${feedbackLog.length} events`;
}

renderReportList();
renderEmpty();
</script>
</body>
</html>